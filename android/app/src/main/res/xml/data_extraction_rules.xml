<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and settings live in the WebView's storage (app_webview), backed up with the app. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
